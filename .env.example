# Copy to .env (git-ignored). Never commit real values.
# Names match project 055 so its SSH helper can be reused.
OVH_VPS_IP=<VPS_IP>
OVH_VPS_USER=ubuntu
OVH_VPS_SSH_PORT=22
OVH_SSH_KEY_PATH=C:\Users\<you>\.ssh\<key>
# Tailscale auth key (tskey-auth-...). Needed only for the first login.
# The deploy script removes it from the VPS .env afterwards.
TS_AUTHKEY=
TS_HOSTNAME=uptime-kuma
# Monitor targets (scripts/seed_monitors.py). Real values only in .env.
# Tailnet IPv4 and MagicDNS name of the VPS host (also the UniFi console name)
VPS_TS_IP=<vps-tailnet-ip>
VPS_TS_FQDN=<vps-host>.<tailnet>.ts.net
# MagicDNS name and tailnet IPv4 of the Kuma sidecar node (push monitors use them)
KUMA_FQDN=uptime-kuma.<tailnet>.ts.net
KUMA_TS_IP=<kuma-tailnet-ip>
